<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 相机权限（发帖拍照） -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 存储权限（图片选择） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HuantuApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HuantuApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <!-- 腾讯地图 API Key -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="JZBBZ-V42LB-CEGUY-JSOBW-KJJO5-KGFN4" />

        <!-- 登录/注册 -->
        <activity
            android:name=".feature.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.HuantuApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.auth.RegisterActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 主页（底部导航容器） -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 路线详情 -->
        <activity
            android:name=".feature.trip.TripDetailActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- AI路线生成 -->
        <activity
            android:name=".feature.trip.RouteGenerateActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 帖子详情 -->
        <activity
            android:name=".feature.community.PostDetailActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 发布帖子 -->
        <activity
            android:name=".feature.community.PublishPostActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 全局搜索 -->
        <activity
            android:name=".feature.search.SearchActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 编辑资料 -->
        <activity
            android:name=".feature.profile.EditProfileActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 设置 -->
        <activity
            android:name=".feature.profile.SettingsActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 收藏列表 -->
        <activity
            android:name=".feature.profile.FavoriteListActivity"
            android:theme="@style/Theme.HuantuApp" />

        <!-- 足迹地图全屏 -->
        <activity
            android:name=".feature.profile.FootprintMapActivity"
            android:theme="@style/Theme.HuantuApp" />
    </application>

</manifest>
